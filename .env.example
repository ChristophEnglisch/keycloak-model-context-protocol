# Copy to .env for local runs. Never commit real values.

# Base URL of your Keycloak server (required)
KEYCLOAK_URL=https://keycloak.example.com

# Realm used to obtain the token (default: master)
# KEYCLOAK_AUTH_REALM=master

# Grant type: client_credentials | password
# Auto: client_credentials if a client secret is set, otherwise password if a username is set
# KEYCLOAK_GRANT_TYPE=client_credentials

# Client for login (default admin-cli for password grant; required otherwise)
# KEYCLOAK_CLIENT_ID=<service-account-client-id>

# client_credentials grant (recommended: dedicated service account, least privilege)
# KEYCLOAK_CLIENT_SECRET=<client-secret>

# password grant (legacy aliases KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD are deprecated)
# KEYCLOAK_USERNAME=<username>
# KEYCLOAK_PASSWORD=<password>

# Safety controls
# Only register read-only tools (default: false)
# KEYCLOAK_MCP_READ_ONLY=true
# Comma-separated allowlist of target realms; empty = all
# KEYCLOAK_MCP_REALMS=my-realm,other-realm
# Allow write tools in the master realm (default: false)
# KEYCLOAK_MCP_ALLOW_MASTER_WRITE=false
# Destructive tools require confirmation (default: true)
# KEYCLOAK_MCP_REQUIRE_CONFIRMATION=true

# Enabled toolsets, comma-separated or "all" (default: core,groups,roles)
# Available: core, groups, roles, clients, sessions, events, security
# KEYCLOAK_MCP_TOOLSETS=core,groups,roles

# HTTP timeout in milliseconds (default: 30000)
# KEYCLOAK_MCP_TIMEOUT_MS=30000

# Log level on stderr: debug | info | warn | error (default: info)
# KEYCLOAK_MCP_LOG_LEVEL=info
